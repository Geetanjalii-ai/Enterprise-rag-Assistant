APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Login
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Neon (PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.region.neon.tech/dbname?sslmode=require

# Qdrant
QDRANT_URL=https://sample-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=enterprise_docs

# Embeddings
JINA_API_KEY=your_jina_api_key_here
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024
RERANKER_MODEL=jina-reranker-v2-base-multilingual
SPARSE_MODEL=Qdrant/bm25

# LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_CONTEXT_TOKEN_BUDGET=3000

# File storage (Backblaze B2, S3-compatible)
STORAGE_BACKEND=b2
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_app_key
B2_BUCKET_NAME=your_b2_bucket
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
LOCAL_STORAGE_DIR=./data/uploads
